{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EiheiZone task frontmatter",
  "description": "docs/tasks/NNN-kebab-topic.md 的 YAML frontmatter 契约",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "status", "created", "branch"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^T[0-9]{3,}$",
      "description": "全局单调编号，与文件名和分支名中的数字一致"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": ["feat", "fix", "docs", "refactor", "chore", "exp"]
    },
    "status": {
      "enum": ["In Progress", "Accepted", "Deferred"]
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "branch": {
      "type": ["string", "null"],
      "pattern": "^(feat|fix|docs|refactor|chore|exp)/[0-9]{3,}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "分支已合并删除或任务延期时可为 null，其余任务必须使用新分支命名公式"
    },
    "archived_in": {
      "type": "string",
      "pattern": "^v[0-9]+(?:\\.[0-9]+)*$",
      "description": "任务被封箱到的版本目录，可选"
    }
  }
}
