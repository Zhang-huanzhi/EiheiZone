@startuml
!theme plain
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam roundcorner 6
skinparam ArrowColor #475569
skinparam ArrowThickness 1.2
skinparam DefaultTextAlignment center
skinparam nodesep 45
skinparam ranksep 55
skinparam rectangle { BackgroundColor #F8FAFC; BorderColor #CBD5E1; FontColor #0F172A }
skinparam database { BackgroundColor #EFF6FF; BorderColor #60A5FA; FontColor #0F172A }
title EiheiZone v1.5.1 - Production Container Architecture
actor "Public / Family / Owner" as user
rectangle "Caddy\nHTTPS / HTTP2 / HTTP3" as caddy
rectangle "Next.js App Router\n页面、Server loader、交互" as frontend
rectangle "FastAPI\n认证、授权、业务、图片处理" as backend
rectangle "notification-worker\n微信 Outbox 重试" as notification
rectangle "media-cleanup-worker\n媒体清理与运行记录" as cleanup
database "PostgreSQL 17\n业务数据与 Session" as db
collections "media_data\nWebP 图片文件" as media
cloud "GitHub Actions\nCI + Deploy" as actions
rectangle "deploy.sh / rollback.sh\n完整 SHA + 健康检查" as release
user -right-> caddy : HTTPS
caddy -right-> frontend : 页面请求
caddy -down-> backend : /api/*
frontend -down-> backend : Server-side API
backend -right-> db : SQLAlchemy / 事务
backend -down-> media : 鉴权读写
notification -right-> db : Outbox
cleanup -right-> db : 清理记录
cleanup -down-> media : 扫描与清理
actions -right-> release : 固定 host key 的 SSH
release ..> backend : Docker Compose
release ..> notification : worker 更新
release ..> cleanup : worker 更新
release ..> caddy : 就绪与公网健康检查
legend bottom
  所有应用容器运行在同一台生产服务器的 Docker Compose internal 网络中。
  PostgreSQL 与 media_data 通过 named volume 持久化。
endlegend
@enduml

