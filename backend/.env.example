APP_NAME=EiheiZone API
APP_ENV=development
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=postgresql+psycopg://eiheizone_app:replace-with-local-password@127.0.0.1:5432/eiheizone_dev
TEST_DATABASE_URL=postgresql+psycopg://eiheizone_app:replace-with-local-password@127.0.0.1:5432/eiheizone_test
APP_ORIGIN=http://localhost:3000
CSRF_SECRET=replace-with-a-long-random-secret-before-production
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
CSRF_TOKEN_TTL_SECONDS=3600
# Directory used for processed Post images.
MEDIA_ROOT=/app/media
