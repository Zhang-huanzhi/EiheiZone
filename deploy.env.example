# Copy this file to .env on the VPS and replace the placeholder values.
POSTGRES_DB=eiheizone
POSTGRES_USER=eiheizone_app
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-password

APP_NAME=EiheiZone API
APP_ENV=production
LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=300
APP_TIMEZONE=Asia/Shanghai
CSRF_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
CSRF_TOKEN_TTL_SECONDS=3600
# WeChat test-account notification PoC (keep disabled until configured)
WECHAT_NOTIFICATIONS_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_TEMPLATE_ID=
NOTIFICATION_WORKER_INTERVAL_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=5
MEDIA_CLEANUP_WORKER_INTERVAL_SECONDS=604800
MEDIA_CLEANUP_ORPHAN_GRACE_HOURS=24
MEDIA_CLEANUP_MAX_ITEMS=1000
